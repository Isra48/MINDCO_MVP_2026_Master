# Copia este archivo a `.env` y rellena los valores reales (NO commitear `.env`).
#
# CONTENT_SOURCE: "mock" usa datos de prueba; "strapi" lee de la API real.
# STRAPI_URL: URL base del proyecto Strapi (sin "/" final). Compatible con v4 y v5.
# STRAPI_API_TOKEN: API Token de tipo Read-only generado en Strapi.
CONTENT_SOURCE=mock
STRAPI_URL=https://your-strapi-instance.com
STRAPI_API_TOKEN=your_api_token_here
LOGIN_REFETCH_ALWAYS=true
LOGIN_STALE_HOURS=12

# CONTENT_CACHE_HOURS: horas que el contenido del CMS (clases/eventos/home) se
# considera fresco y vive en caché entre arranques. Más alto = menos llamadas a
# Strapi (cuida la prueba gratuita). El pull-to-refresh siempre fuerza datos nuevos.
# Aplica en PRODUCCIÓN (cuando CONTENT_PREVIEW_MODE no es "true").
CONTENT_CACHE_HOURS=6

# CONTENT_PREVIEW_MODE: "true" durante fase de pruebas. Refresca el contenido
# casi en tiempo real (al navegar entre pantallas o volver la app a primer plano),
# sin polling: solo refetchea cuando la data pasó su ventana de frescura corta.
# Déjalo en "false" o quítalo para builds de producción.
CONTENT_PREVIEW_MODE=false
# Segundos que la data se considera fresca en modo preview (default 30).
CONTENT_PREVIEW_STALE_SECONDS=30

# Supabase Auth: URL del proyecto y anon/publishable key (pública, segura en cliente).
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=sb_publishable_xxx
